<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wordcraze" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="The Word Craze Game — the interactive word association game!">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="bg-gray-50 min-h-screen flex flex-col">
    <header class="bg-white shadow-sm border-b h-16 flex items-center px-4 md:px-6 flex-shrink-0">
      <div class="flex items-center justify-between w-full max-w-7xl mx-auto gap-4">
        <%= link_to root_path, class: "text-xl font-bold text-blue-800 hover:text-blue-600 whitespace-nowrap" do %>
          Wordcraze
        <% end %>

        <div class="flex-1 max-w-xs">
          <%= form_with url: search_path, method: :get, data: { turbo: false } do |f| %>
            <%= f.text_field :q,
                id: "s",
                placeholder: "Search words…",
                autocomplete: "off",
                class: "w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
          <% end %>
        </div>

        <nav class="flex items-center gap-3 text-sm">
          <%= link_to "About", about_path, class: "text-gray-600 hover:text-gray-900 hidden sm:inline" %>
          <%= link_to "Feedback", give_feedback_path, class: "text-gray-600 hover:text-gray-900 hidden sm:inline" %>
          <% if user_signed_in? %>
            <%= link_to "Sign out", destroy_session_path,
                data: { turbo_method: :delete },
                class: "text-gray-600 hover:text-gray-900" %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: "text-gray-600 hover:text-gray-900" %>
            <%= link_to "Register", new_registration_path,
                class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg transition-colors" %>
          <% end %>
        </nav>
      </div>
    </header>

    <% if notice.present? %>
      <div class="bg-green-50 border-l-4 border-green-400 px-4 py-3 text-green-700 text-sm">
        <%= notice %>
      </div>
    <% end %>
    <% if alert.present? %>
      <div class="bg-red-50 border-l-4 border-red-400 px-4 py-3 text-red-700 text-sm">
        <%= alert %>
      </div>
    <% end %>

    <main class="flex-1 flex flex-col">
      <%= yield %>
    </main>
  </body>
</html>
