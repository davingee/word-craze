<% content_for :title, "Feedback — Wordcraze" %>

<div class="max-w-xl mx-auto py-10 px-4">
  <h2 class="text-2xl font-bold text-gray-900 mb-1">Give us your feedback</h2>
  <p class="text-gray-500 text-sm mb-6">Remember — you may choose to be nice!</p>

  <%= form_with model: @contact, url: give_feedback_path, method: :post do |f| %>
    <% if @contact.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded-lg px-4 py-3 mb-5">
        <ul class="list-disc pl-4 text-red-700 text-sm space-y-1">
          <% @contact.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.email_field :email,
            id: "contact_email",
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
      </div>

      <div>
        <%= f.label :comments, "Your feedback", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_area :comments,
            rows: 6,
            class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none" %>
      </div>

      <%= f.submit "Send feedback",
          class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-2.5 px-4 rounded-lg transition-colors cursor-pointer" %>
    </div>
  <% end %>
</div>
