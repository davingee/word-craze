<% content_for :title, "Sign in — Wordcraze" %>

<div class="min-h-full flex items-center justify-center py-16 px-4">
  <div class="w-full max-w-sm space-y-6">
    <div class="text-center">
      <h2 class="text-3xl font-extrabold text-gray-900">Sign in</h2>
      <p class="mt-2 text-sm text-gray-500">Use your passkey — no password needed</p>
    </div>

    <div data-controller="webauthn">
      <div data-webauthn-target="error"
           class="hidden mb-4 bg-red-50 border border-red-200 rounded-lg px-4 py-3 text-red-700 text-sm">
      </div>

      <button data-action="click->webauthn#authenticate"
              class="w-full flex justify-center items-center gap-2 py-3 px-4 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
        </svg>
        Sign in with passkey
      </button>
    </div>

    <p class="text-center text-sm text-gray-500">
      Don't have an account?
      <%= link_to "Register", new_registration_path,
          class: "font-medium text-blue-600 hover:text-blue-500" %>
    </p>
  </div>
</div>
